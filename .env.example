# World Monitor Security Assessment Platform - Environment Configuration

# Application
APP_NAME=World Monitor Security Assessment
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./security_assessment.db

# Safety
SAFE_MODE=true
ALLOWED_TARGETS=https://www.worldmonitor.app,http://localhost:5173

# Target
TARGET_URL=https://www.worldmonitor.app
TARGET_REPO=https://github.com/koala73/worldmonitor
TARGET_LOCAL_PATH=./target-source

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60

# Reports
REPORTS_DIR=./reports
EVIDENCE_DIR=./evidence

# Frontend
VITE_API_URL=http://localhost:8000
